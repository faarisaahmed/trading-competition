# ---------------------------------------------------------------------------
# 2026 Model Trading Competition -- credentials
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# Market data is read ONCE per tick from a single shared account and broadcast
# to every team, so all eight strategies see a byte-identical view of the tape.
# These are the keys used for that shared data feed (any paper account works).
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=

# Alpaca endpoints. Leave as-is for paper trading.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# "iex" (free tier) or "sip" (paid, full consolidated tape).
ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# One paper account per team. Each team trades its OWN portfolio, so each
# needs its own key pair. Create 8 paper accounts at app.alpaca.markets and
# paste the keys below.
#
# If you only have ONE Alpaca account right now, run with
#   comp run --round 1 --broker sim
# which uses the built-in fill simulator instead (no keys needed), or set
#   COMP_SINGLE_ACCOUNT_TEAM=trend_rider
# to run exactly one team live against the shared keys.
# ---------------------------------------------------------------------------

ALPACA_TREND_RIDER_KEY_ID=
ALPACA_TREND_RIDER_SECRET_KEY=

ALPACA_MEAN_REVERTER_KEY_ID=
ALPACA_MEAN_REVERTER_SECRET_KEY=

ALPACA_Q_LEARNER_KEY_ID=
ALPACA_Q_LEARNER_SECRET_KEY=

ALPACA_GAMBLER_KEY_ID=
ALPACA_GAMBLER_SECRET_KEY=

ALPACA_STAT_ARB_KEY_ID=
ALPACA_STAT_ARB_SECRET_KEY=

ALPACA_NEWS_HOUND_KEY_ID=
ALPACA_NEWS_HOUND_SECRET_KEY=

ALPACA_VOL_BREAKOUT_KEY_ID=
ALPACA_VOL_BREAKOUT_SECRET_KEY=

ALPACA_SCALPER_KEY_ID=
ALPACA_SCALPER_SECRET_KEY=

# Optional: benchmark (unscored equal-weight buy & hold reference).
ALPACA_BENCHMARK_KEY_ID=
ALPACA_BENCHMARK_SECRET_KEY=
